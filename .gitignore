# 本机私有开发状态（启动脚本、测试输出、UI 预览、抓帧探针）。
.local/

# 构建/打包暂存。
build/
/mods/

# 发布包留在本地，不入公开仓库。
dist/

# 3DMigoto 二进制：自编译补丁版 d3d11.dll 入库，第三方再分发件不入库。
3Dmigoto_v1.4.9/
3dmigoto_gkms/*.dll
!3dmigoto_gkms/d3d11.dll
3dmigoto_gkms/ShaderCache/

# 提取或派生的游戏资产不得推进公开仓库。
research/body-mesh-projections.png
research/texture-previews/*.png
research/texture-previews/*.jpg
research/inverse-skin/**/*.buf
profiles/**/Reference/
gakumas_mi/resources/assetstudio-body-json/

# Python/Blender 缓存。
__pycache__/
*.py[cod]
.pytest_cache/

# 本机 Claude Code 会话配置。此前只靠全局 gitignore 挡着，换台机器就会被提交。
.claude/settings.local.json

# 自带打包器：UnityPy/Pillow 的 wheel，由 tools/package_blender_addon.py --with-unitypy 现装
gakumas_mi/vendor/

# Blender 无头跑留下的日志
Logs/

# Unity SDK 实验台（research/unity-humanoid-avatar-sdk/）：这些东西 2026-08-20 从历史里剥掉了。
# 它们曾把 15 个未推送提交撑到 280 MB —— Library 是纯缓存，其余是可重新生成或本机备份的
# 大块二进制。文件仍在磁盘上，只是不进 git；哪些能怎么重建见该目录的 README。
research/unity-humanoid-avatar-sdk/GakumasAvatarSdk/Library/
research/unity-humanoid-avatar-sdk/GakumasAvatarSdk/UserSettings/
research/unity-humanoid-avatar-sdk/GakumasAvatarSdk/Temp/
research/unity-humanoid-avatar-sdk/GakumasAvatarSdk/Obj/
research/unity-humanoid-avatar-sdk/GakumasAvatarSdk/Assets/**/*.png
research/unity-humanoid-avatar-sdk/GakumasAvatarSdk/Assets/**/*.png.meta
research/unity-humanoid-avatar-sdk/GakumasAvatarSdk/Assets/**/*.asset
research/unity-humanoid-avatar-sdk/GakumasAvatarSdk/Assets/**/*.asset.meta
research/unity-humanoid-avatar-sdk/GakumasAvatarSdk/Assets/**/*.fbx
research/unity-humanoid-avatar-sdk/GakumasAvatarSdk/Assets/**/*.fbx.meta
research/unity-humanoid-avatar-sdk/.backup/
research/unity-humanoid-avatar-sdk/reference/asset-inventory.json
