{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gakumas.local/avatar-sdk/avatar-descriptor-v1.schema.json",
  "title": "Gakumas Avatar Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "sdkVersion",
    "unityVersion",
    "buildId",
    "avatarRoot",
    "animator",
    "renderers",
    "expressions",
    "springChains",
    "colliders",
    "rootMotion",
    "materials"
  ],
  "properties": {
    "protocol": { "const": 1 },
    "sdkVersion": { "type": "string", "minLength": 1 },
    "unityVersion": { "type": "string", "minLength": 1 },
    "buildId": { "type": "string", "minLength": 1 },
    "avatarRoot": { "$ref": "#/$defs/localPath" },
    "animator": { "$ref": "#/$defs/localPath" },
    "renderers": {
      "type": "array",
      "items": { "$ref": "#/$defs/renderer" }
    },
    "expressions": {
      "type": "array",
      "items": { "$ref": "#/$defs/expression" }
    },
    "springChains": {
      "type": "array",
      "items": { "$ref": "#/$defs/springChain" }
    },
    "colliders": {
      "type": "array",
      "items": { "$ref": "#/$defs/collider" }
    },
    "rootMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "groundOffset", "scaleMode"],
      "properties": {
        "mode": { "enum": ["actorAnchored", "matchGameHeight"] },
        "groundOffset": { "type": "number" },
        "scaleMode": { "enum": ["author", "matchGame"] }
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["standard", "custom", "hybrid"] }
      }
    }
  },
  "$defs": {
    "localPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+"
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "rendererType"],
      "properties": {
        "path": { "$ref": "#/$defs/localPath" },
        "role": { "enum": ["body", "face", "hair", "accessory", "effect", "ignore"] },
        "rendererType": { "enum": ["SkinnedMeshRenderer", "MeshRenderer"] },
        "blendShapes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "outputs"],
      "properties": {
        "channel": { "type": "string", "minLength": 1 },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rendererPath", "blendShape", "scale", "mode"],
            "properties": {
              "rendererPath": { "$ref": "#/$defs/localPath" },
              "blendShape": { "type": "string", "minLength": 1 },
              "scale": { "type": "number" },
              "mode": { "enum": ["max", "addClamp", "multiply"] }
            }
          }
        }
      }
    },
    "springChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nodes", "stiffness", "damping", "gravity"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "nodes": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/localPath" } },
        "stiffness": { "type": "number" },
        "damping": { "type": "number" },
        "gravity": { "type": "number" }
      }
    },
    "collider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "shape", "radius"],
      "properties": {
        "path": { "$ref": "#/$defs/localPath" },
        "shape": { "enum": ["sphere", "capsule"] },
        "radius": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
