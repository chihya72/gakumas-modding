{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gakumas.local/avatar-sdk/manifest-v1.schema.json",
  "title": "Gakumas Avatar Mod Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "author",
    "enabled",
    "bundle",
    "asset",
    "descriptor",
    "targets"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "enabled": { "type": "boolean" },
    "bundle": { "$ref": "#/$defs/relativePath" },
    "asset": { "$ref": "#/$defs/bundlePath" },
    "descriptor": { "$ref": "#/$defs/bundlePath" },
    "cover": { "$ref": "#/$defs/relativePath" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["characterId"],
        "properties": {
          "characterId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,31}$"
          }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+"
    },
    "bundlePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?:[^/]+/)*[^/]+$"
    }
  }
}
