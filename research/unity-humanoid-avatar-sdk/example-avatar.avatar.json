{
  "protocol": 1,
  "sdkVersion": "0.1.0-p1",
  "unityVersion": "6000.0.67f1",
  "buildId": "example-avatar-20260813",
  "avatarRoot": "Root",
  "animator": "Root/Avatar",
  "renderers": [
    { "path": "Root/Body", "role": "body", "rendererType": "SkinnedMeshRenderer", "blendShapes": [] },
    { "path": "Root/Face", "role": "face", "rendererType": "SkinnedMeshRenderer", "blendShapes": ["Smile", "Blink", "あ", "い", "う", "え", "お"] },
    { "path": "Root/Hair", "role": "hair", "rendererType": "SkinnedMeshRenderer", "blendShapes": [] }
  ],
  "expressions": [
    { "channel": "smile", "outputs": [{ "rendererPath": "Root/Face", "blendShape": "Smile", "scale": 1.0, "mode": "max" }] },
    { "channel": "blink", "outputs": [{ "rendererPath": "Root/Face", "blendShape": "Blink", "scale": 1.0, "mode": "max" }] }
  ],
  "springChains": [
    { "id": "hair.main", "nodes": ["Root/HairBone0", "Root/HairBone0/HairBone1"], "stiffness": 0.5, "damping": 0.2, "gravity": 1.0 }
  ],
  "colliders": [],
  "rootMotion": { "mode": "actorAnchored", "groundOffset": 0.0, "scaleMode": "author" },
  "materials": { "mode": "standard" }
}
