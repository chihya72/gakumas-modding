<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="NavigationPanelStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushToken}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style x:Key="CardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushToken}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="SlotVariantCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="#FFFFFAF2" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="CoverPlaceholderStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{StaticResource AccentPaleBrush}" />
        <Setter Property="BorderBrush" Value="#FFFFD58A" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>

    <Style x:Key="AppTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="AppSubtitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="PanelTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Margin" Value="0,0,8,6" />
    </Style>

    <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="12,4" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushToken}" />
        <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
    </Style>

    <Style x:Key="ToolbarButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Margin" Value="10,0" />
    </Style>

    <Style x:Key="SmallButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style x:Key="FilterButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
    </Style>

    <Style x:Key="ToolbarTextBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushToken}" />
    </Style>

    <Style x:Key="SearchTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource ToolbarTextBoxStyle}">
        <Setter Property="Margin" Value="8,0,14,0" />
    </Style>

    <Style x:Key="SummaryChipStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
    </Style>

    <Style x:Key="ModDataGridStyle" TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="RowBackground" Value="{StaticResource PanelBackgroundBrush}" />
        <Setter Property="AlternatingRowBackground" Value="#FFFCFCFD" />
        <Setter Property="SelectionUnit" Value="FullRow" />
    </Style>
</ResourceDictionary>

