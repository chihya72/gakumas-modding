<Window x:Class="GakumasModManager.Views.RootView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:s="https://github.com/canton7/Stylet"
        xmlns:conv="clr-namespace:GakumasModManager.Converters"
        mc:Ignorable="d"
        Title="{Binding DisplayName}"
        Width="1440"
        Height="860"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">
    <Window.Resources>
        <conv:CoverImageConverter x:Key="CoverImageConverter" />
    </Window.Resources>
    <Grid Margin="22,18,22,18" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="170" MinHeight="90" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="游戏路径" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ToolbarTextBoxStyle}" />
            <Button Grid.Column="2" Content="浏览…" Command="{s:Action BrowseGamePath}" Style="{StaticResource ToolbarButtonStyle}" />
            <Button Grid.Column="3" Content="刷新" Command="{s:Action RefreshPackages}" Style="{StaticResource ToolbarButtonStyle}" />
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="角色" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="150"
                          ItemsSource="{Binding CharacterFilters}"
                          SelectedItem="{Binding SelectedCharacterFilter}" />
            </StackPanel>
            <TextBlock Grid.Column="5" Text="{Binding SummaryText}" Style="{StaticResource SummaryChipStyle}" />
            <Button Grid.Column="6" Content="F10 重载游戏" Command="{s:Action ReloadGame}" Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="440" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="400" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <DataGrid ItemsSource="{Binding PackagesView}"
                          SelectedItem="{Binding SelectedPackage}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="44"
                          BorderThickness="0"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Style="{StaticResource ModDataGridStyle}">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="True" Margin="0,2"
                                                          Loaded="OnGroupExpanderLoaded"
                                                          Expanded="OnGroupExpanderToggled"
                                                          Collapsed="OnGroupExpanderToggled">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource MainTextBrush}" />
                                                            <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                                                                       Foreground="{StaticResource MutedTextBrush}" />
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <ItemsPresenter />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2.2*" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="作者" Binding="{Binding Author}" Width="*" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="0.8*" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="1.3*" ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="状态" Binding="{Binding StatusLabel}" Width="1.2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellTextStyle}">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Enabled">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Conflict">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Broken">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" Margin="4,0"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" Style="{StaticResource GridSplitterStyle}" />

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <DockPanel Margin="16">
                    <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,12,0,0">
                        <Button Content="{Binding ToggleSelectedPackageText}"
                                Command="{s:Action ToggleSelectedPackage}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Content="打开目录" Command="{s:Action OpenSelectedPackageFolder}" Style="{StaticResource SecondaryButtonStyle}" />
                    </UniformGrid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedPackage.Name}" Style="{StaticResource PanelTitleTextStyle}" />
                            <Border Margin="0,12,0,0"
                                    Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                                    Style="{StaticResource CoverPlaceholderStyle}" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="封面预览" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <Image Source="{Binding SelectedPackage.CoverPath, Converter={StaticResource CoverImageConverter}}"
                                           Stretch="Uniform" />
                                </Grid>
                            </Border>

                            <UniformGrid Columns="2" Margin="0,12,0,10">
                                <TextBlock Text="类型" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding SelectedPackage.TypeLabel}" />
                                <TextBlock Text="作者" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding SelectedPackage.Author}" />
                                <TextBlock Text="版本" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding SelectedPackage.Version}" />
                                <TextBlock Text="目标" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding SelectedPackage.Target}" />
                                <TextBlock Text="标识" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding SelectedPackage.Id}" />
                                <TextBlock Text="缺失文件" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding SelectedPackage.MissingFileCount}" />
                                <TextBlock Text="DDS错误" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding SelectedPackage.InvalidDdsCount}" />
                            </UniformGrid>

                            <TextBlock Text="{Binding SelectedPackage.DirectoryPath}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10" />

                            <ItemsControl ItemsSource="{Binding SelectedPackage.Checks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Margin="0,4" Foreground="{StaticResource MainTextBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2" Height="6" Margin="0,4"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" Style="{StaticResource GridSplitterStyle}" />

        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <DockPanel Margin="16,10">
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="日志" Style="{StaticResource PanelTitleTextStyle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="键位说明" Command="{s:Action OpenShortcutsDoc}" Style="{StaticResource SmallButtonStyle}" />
                        <Button Content="打开 3DMigoto 日志" Command="{s:Action OpenD3dmigotoLog}" Style="{StaticResource SmallButtonStyle}" />
                        <Button Content="清空" Command="{s:Action ClearLogs}" Style="{StaticResource SmallButtonStyle}" />
                        <Button Content="打开日志目录" Command="{s:Action OpenLogDirectory}" Style="{StaticResource SmallButtonStyle}" />
                    </StackPanel>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}">
                                    <Run Text="{Binding Time}" />
                                    <Run Text="    " />
                                    <Run Text="{Binding Message}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
