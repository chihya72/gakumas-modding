<Window x:Class="GakumasModManager.Views.RootView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:s="https://github.com/canton7/Stylet"
        mc:Ignorable="d"
        Title="{Binding DisplayName}"
        Width="1440"
        Height="860"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="148" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource NavigationPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="20,18,16,20">
                    <TextBlock Text="Gakumas" Style="{StaticResource AppTitleTextStyle}" />
                    <TextBlock Text="Mod Manager" Style="{StaticResource AppSubtitleTextStyle}" />
                </StackPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Style="{StaticResource NavButtonStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="2" Margin="20,0,20,20">
                    <TextBlock Text="v0.4.x" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="就绪" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="124" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="游戏路径" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ToolbarTextBoxStyle}" />
                <Button Grid.Column="2" Content="刷新" Command="{s:Action RefreshPackages}" Style="{StaticResource ToolbarButtonStyle}" />
                <TextBox Grid.Column="3" Text="{Binding SearchText}" Style="{StaticResource SearchTextBoxStyle}" />
                <TextBlock Grid.Column="4" Text="{Binding SummaryText}" Style="{StaticResource SummaryChipStyle}" />
                <Button Grid.Column="5" Content="F10 重载游戏" Command="{s:Action ReloadGame}" Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="400" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="140" />
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="14,12,14,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ItemsControl ItemsSource="{Binding Filters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Style="{StaticResource FilterButtonStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Grid.Column="1" Text="排序：名称 A-Z" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" />
                        </Grid>

                        <DataGrid ItemsSource="{Binding Packages}"
                                  SelectedItem="{Binding SelectedPackage}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  RowHeight="64"
                                  BorderThickness="0"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  Style="{StaticResource ModDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2.2*" />
                                <DataGridTextColumn Header="作者" Binding="{Binding Author}" Width="*" />
                                <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="0.8*" />
                                <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="1.3*" />
                                <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="0.7*" IsReadOnly="True" />
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusLabel}" Width="0.9*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Grid.RowSpan="2" Margin="14,0,0,0" Style="{StaticResource CardStyle}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="122" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding SelectedPackage.Name}" Style="{StaticResource PanelTitleTextStyle}" />
                        <Border Grid.Row="1" Style="{StaticResource CoverPlaceholderStyle}">
                            <TextBlock Text="封面预览" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>

                        <UniformGrid Grid.Row="2" Columns="2" Margin="0,12,0,10">
                            <TextBlock Text="类型" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding SelectedPackage.TypeLabel}" />
                            <TextBlock Text="作者" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding SelectedPackage.Author}" />
                            <TextBlock Text="版本" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding SelectedPackage.Version}" />
                            <TextBlock Text="目标" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding SelectedPackage.Target}" />
                            <TextBlock Text="标识" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding SelectedPackage.Id}" />
                            <TextBlock Text="缺失文件" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding SelectedPackage.MissingFileCount}" />
                            <TextBlock Text="DDS错误" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding SelectedPackage.InvalidDdsCount}" />
                        </UniformGrid>

                        <TextBlock Grid.Row="3"
                                   Text="{Binding SelectedPackage.DirectoryPath}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />

                        <ItemsControl Grid.Row="4" ItemsSource="{Binding SelectedPackage.Checks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Margin="0,4" Foreground="{StaticResource MainTextBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Grid.Row="5">
                            <UniformGrid Columns="3" Margin="0,0,0,12">
                                <Button Content="{Binding ToggleSelectedPackageText}"
                                        Command="{s:Action ToggleSelectedPackage}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Content="备份 mod.ini" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="F10 重载" Command="{s:Action ReloadGame}" Style="{StaticResource SecondaryButtonStyle}" />
                            </UniformGrid>

                            <Border Style="{StaticResource SlotVariantCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="抓帧补全 slotVariants" Style="{StaticResource PanelTitleTextStyle}" />
                                    <TextBox Text="D:\Gakumas\FrameAnalysis-*" Style="{StaticResource ToolbarTextBoxStyle}" Margin="0,10,0,8" />
                                    <TextBlock Text="1 选择抓帧  ->  2 Hash 匹配  ->  3 更新 mod.ini  ->  4 重载验证"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <Button Content="从抓帧学习槽位"
                                            Command="{s:Action LearnSlotVariants}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="5" Text="3DMigoto 快捷设置 (d3dx.ini)" Style="{StaticResource PanelTitleTextStyle}" />
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="Hunting 模式" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding HuntingMode}" Style="{StaticResource ToolbarTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="抓帧键" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding FrameAnalysisKey}" Style="{StaticResource ToolbarTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="重载键" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding ReloadKey}" Style="{StaticResource ToolbarTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="3">
                            <TextBlock Text="备份保留数量" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding BackupKeepCount}" Style="{StaticResource ToolbarTextBoxStyle}" />
                        </StackPanel>
                        <Button Grid.Row="1"
                                Grid.Column="4"
                                Content="立即备份 d3dx.ini"
                                Command="{s:Action BackupD3dxIni}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                <DockPanel Margin="16,10">
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="日志" Style="{StaticResource PanelTitleTextStyle}" />
                        <Button Grid.Column="1" Content="清空" Command="{s:Action ClearLogs}" Style="{StaticResource SmallButtonStyle}" />
                        <Button Grid.Column="2" Content="打开日志目录" Command="{s:Action OpenLogDirectory}" Style="{StaticResource SmallButtonStyle}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}">
                                    <Run Text="{Binding Time}" />
                                    <Run Text="    " />
                                    <Run Text="{Binding Message}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
