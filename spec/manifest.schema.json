{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gakumasmi.local/schema/manifest-v1.json",
  "title": "GakumasMI Mod Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "author", "type", "profile", "targets", "dependencies", "conflicts", "runtime", "status"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9-]+)+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "author": { "type": "string", "minLength": 1, "maxLength": 100 },
    "type": { "enum": ["renderer-hide", "texture-replacement", "mesh-replacement", "shader-replacement", "mixed"] },
    "profile": { "type": "string", "minLength": 1 },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*$" }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+(?:\\.[A-Za-z0-9-]+)+$" }
    },
    "runtime": { "type": "string", "pattern": "^>=[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["draft", "poc", "stable", "deprecated"] }
  }
}
