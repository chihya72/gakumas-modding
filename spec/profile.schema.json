{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gakumasmi.local/schema/profile-v1.json",
  "title": "GakumasMI Drawcall Profile v1",
  "type": "object",
  "required": ["schemaVersion", "id", "status", "game", "target", "capture", "layout", "skinning", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "game": {
      "type": "object",
      "required": ["unityVersion", "buildGuid", "exeSha256"],
      "properties": {
        "unityVersion": { "type": "string" },
        "buildGuid": { "type": "string", "pattern": "^[0-9a-fA-F]{32}$" },
        "exeSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      }
    },
    "target": {
      "type": "object",
      "required": ["actorId", "costumeId", "bodyResource", "faceResource", "hairResource", "environment", "script"]
    },
    "capture": {
      "type": "object",
      "required": ["directory", "timestamp", "drawCalls", "files", "bytes", "options"]
    },
    "layout": { "type": "object" },
    "skinning": {
      "type": "object",
      "required": ["drawInput", "boneIndexFormat", "boneWeightFormat", "upstreamSource"]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "confidence", "ibHash", "vbHashes", "vertices"],
        "properties": {
          "id": { "type": "string" },
          "confidence": { "enum": ["candidate", "high", "verified"] },
          "ibHash": { "type": "string", "pattern": "^[0-9a-fA-F]{8}$" },
          "vbHashes": {
            "type": "object",
            "additionalProperties": { "type": "string", "pattern": "^[0-9a-fA-F]{8}$" }
          },
          "vertices": { "type": "integer", "minimum": 1 },
          "indices": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
